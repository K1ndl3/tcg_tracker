# Server
PORT=4000
NODE_ENV=development

# Where the frontend runs (used for CORS + cookie settings)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgres://tcg:tcg_dev_password@localhost:5432/tcg_tracker

# Secret used to sign auth JWTs. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret
# How long a login session lasts
JWT_EXPIRES_IN=7d

# Google OAuth: create one at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
